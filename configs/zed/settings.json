// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "plan",
        "effort": "high",
        "model": "sonnet"
      },
      "type": "registry"
    }
  },
  "ui_font_family": "JetBrains Mono NL",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Adwaita Dark",
  },
  "theme_overrides": {
    "Adwaita Dark": {
      "syntax": {
        "attribute": { "color": "#EAEAEA", "font_weight": null },
        "boolean": { "color": "#EAEAEA", "font_weight": null },
        "class": { "color": "#4E8818" },
        "comment": { "color": "#777777" },
        "comment.doc": { "color": "#999897" },
        "constant": { "color": "#EAEAEA", "font_weight": null },
        "constructor": { "color": "#4E8818" },
        "embedded": { "color": "#EAEAEA", "font_weight": null },
        "emphasis": { "color": "#EAEAEA", "font_weight": null },
        "emphasis.strong": { "color": "#EAEAEA", "font_weight": null },
        "enum": { "color": "#EAEAEA", "font_weight": null },
        "function": { "color": "#73A2D9" },
        "function.method": { "color": "#8690BE" },
        "function.special.definition": { "color": "#EAEAEA", "font_weight": null },
        "hint": { "color": "#EAEAEA", "font_weight": null },
        "id": { "color": "#EAEAEA", "font_weight": null },
        "keyword": { "color": "#E8A35F" },
        "label": { "color": "#EAEAEA", "font_weight": null },
        "link_text": { "color": "#EAEAEA", "font_weight": null },
        "link_uri": { "color": "#EAEAEA", "font_weight": null },
        "number": { "color": "#EAEAEA", "font_weight": null },
        "operator": { "color": "#EAEAEA", "font_weight": null },
        "predictive": { "color": "#5E5E5E" },
        "predoc": { "color": "#EAEAEA", "font_weight": null },
        "preproc": { "color": "#EAEAEA", "font_weight": null },
        "primary": { "color": "#EAEAEA", "font_weight": null },
        "property": { "color": "#EAEAEA", "font_weight": null },
        "pseudo": { "color": "#EAEAEA", "font_weight": null },
        "punctuation": { "color": "#EAEAEA", "font_weight": null },
        "punctuation.bracket": { "color": "#EAEAEA", "font_weight": null },
        "punctuation.delimiter": { "color": "#EAEAEA", "font_weight": null },
        "punctuation.list_marker": { "color": "#EAEAEA", "font_weight": null },
        "punctuation.special": { "color": "#EAEAEA", "font_weight": null },
        "punctuation.special.symbol": { "color": "#EAEAEA", "font_weight": null },
        "string": { "color": "#69BAA8" },
        "string.escape": { "color": "#EAEAEA", "font_weight": null },
        "string.regex": { "color": "#EAEAEA", "font_weight": null },
        "string.special": { "color": "#EAEAEA", "font_weight": null },
        "string.special.symbol": { "color": "#EAEAEA", "font_weight": null },
        "text.literal": { "color": "#EAEAEA", "font_weight": null },
        "title": { "color": "#EAEAEA", "font_weight": null },
        "type": { "color": "#69BAA8" },
        "type.builtin": { "color": "#69BAA8" },
        "type.interface": { "color": "#69BAA8" },
        "type.super": { "color": "#69BAA8" },
        "variable": { "color": "#EAEAEA", "font_weight": null },
        "variable.member": { "color": "#EAEAEA", "font_weight": null },
        "variable.parameter": { "color": "#EAEAEA", "font_weight": null },
        "variable.special": { "color": "#EAEAEA", "font_weight": null },
        "variant": { "color": "#EAEAEA", "font_weight": null }
      }
    }
  },
}
