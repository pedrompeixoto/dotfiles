[
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious",
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space /": "pane::DeploySearch",
      "space g b": "git::CheckoutBranch",

      "space d": "editor::Hover",
      "space f": "editor::Format",

      "space s v": "pane::SplitRight",
      "space s h": "pane::SplitDown",

      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",

      "ctrl-alt-h": "vim::ResizePaneLeft",
      "ctrl-alt-l": "vim::ResizePaneRight",
      "ctrl-alt-j": "vim::ResizePaneDown",
      "ctrl-alt-k": "vim::ResizePaneUp",

      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePreviousItem",

      "g r n": "editor::Rename",
      "g r a": "editor::ToggleCodeActions",
      "g r r": "editor::FindAllReferences",
      "g r i": "editor::GoToImplementation",
      "g r t": "editor::GoToTypeDefinition",
      "g shift-o": "outline::Toggle",
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "space f": "editor::Format",
      "g r a": "editor::ToggleCodeActions",
    },
  },
]
