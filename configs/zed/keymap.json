// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space /": "pane::DeploySearch",
      "space e": "project_panel::ToggleFocus",
      "space t h": "workspace::ToggleLeftDock",
      "space ,": "tab_switcher::Toggle",
      "space g g": "git_panel::Toggle",
      "space t l": "workspace::ToggleRightDock",

      "space g c": ["workspace::SendKeystrokes", "ctrl-shift-g i"], // focus commit message box — type it, then cmd-enter to commit (cmd-shift-enter to amend)
      "space g a": "git::ToggleStaged",
      "space g A": "git::StageAll",
      "space g p": "git::Push",
      "space g shift-p": "git::Pull",
      "space g f": "git::Fetch",
      "space f": "editor::Format",
      "space d": "editor::Hover",
      "ctrl-/": "terminal_panel::Toggle",

      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-H": "pane::ActivatePreviousItem",
      "ctrl-L": "pane::ActivateNextItem",
      "space v": "pane::SplitVertical",
      "space s": "pane::SplitHorizontal",

      "ctrl-alt-h": "vim::ResizePaneLeft",
      "ctrl-alt-l": "vim::ResizePaneRight",
      "ctrl-alt-k": "vim::ResizePaneUp",
      "ctrl-alt-j": "vim::ResizePaneDown",

      "space c c": "agent::FocusAgent",
      "space c n": "agent::NewThread",
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "space c a": "agent::AddSelectionToThread",
    },
  },
  {
    // Buffer switching on Shift-H/L, mirroring keymaps.lua's <S-h>/<S-l>,
    // overriding vim's native window-top/bottom motion
    "context": "VimControl && !menu",
    "bindings": {
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
    },
  },
]
